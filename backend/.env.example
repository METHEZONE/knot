# knot 백엔드 환경변수 예시 — 복사해서 .env 로 쓰고 실제 값 채우기 (.env는 커밋 금지)

# Solana
SOLANA_CLUSTER=testnet
SOLANA_RPC_URL=https://api.testnet.solana.com
KNOT_ESCROW_NETWORK=solanaTestnet
KNOT_WEB3_SIGNING_MODE=simulated
# 배포 지갑 keypair 경로 (mainnet 키 절대 커밋 금지)
ANCHOR_WALLET=~/.config/solana/id.json
KNOT_BRAND_KEYPAIR_PATH=
KNOT_BRAND_KEYPAIR_JSON=
KNOT_CREATOR_KEYPAIR_PATH=
KNOT_CREATOR_KEYPAIR_JSON=
KNOT_AGENT_KEYPAIR_PATH=
KNOT_AGENT_KEYPAIR_JSON=

# Testnet SPL mint used for the demo asset. Fill this with the deployed testnet mint.
KNOT_USDC_MINT=

# knot-escrow testnet 프로그램 ID (anchor keys list 로 확인)
KNOT_ESCROW_PROGRAM_ID=

# testnet 통합 테스트 실행 스위치 (1이면 실행, 아니면 skip)
KNOT_RUN_TESTNET=0

# pay.sh / x402 sandbox verification
PAYSH_MODE=sandbox
PAYSH_RESOURCE_ID=replace-me
PAYSH_TIMEOUT_SECONDS=90
PAYSH_QUOTE_AMOUNT_USDC=0.02
PAYSH_MAX_CALL_AMOUNT_USDC=0.02
PAYSH_RUN_SPEND_CAP_USDC=0.02
PAYSH_DAILY_SPEND_CAP_USDC=1.0
PAYSH_ALLOWED_RESOURCE_PREFIXES=https://debugger.pay.sh/mpp/quote/
PAYSH_FAILURE_POLICY=continue

# Product API -> Creator A2A HTTP boundary
KNOT_CREATOR_A2A_MODE=local
CREATOR_AGENT_BASE_URL=http://localhost:8081/a2a/v1
CREATOR_A2A_TIMEOUT_SECONDS=30

# Firebase Auth
KNOT_AUTH_MODE=firebase
FIREBASE_PROJECT_ID=knot-dev-503505
# Local tests only: use KNOT_AUTH_MODE=emulator with Firebase Auth emulator tokens.

# knot 백엔드 환경변수 예시 — 복사해서 .env 로 쓰고 실제 값 채우기 (.env는 커밋 금지)

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
# 배포 지갑 keypair 경로 (mainnet 키 절대 커밋 금지)
ANCHOR_WALLET=~/.config/solana/id.json

# USDC-SPL devnet mint (x402/pay.sh 표준 결제 토큰)
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# knot-escrow 프로그램 ID (anchor keys list 로 확인)
KNOT_ESCROW_PROGRAM_ID=Hv74c9a4rKMHpsy7hgCj7a11tDRaAZG49Ss7bLscs5hu

# devnet 통합 테스트 실행 스위치 (1이면 실행, 아니면 skip)
KNOT_RUN_DEVNET=0

# Shared
KNOT_ENV=local
GCP_PROJECT_ID=replace-me
GCP_REGION=us-central1
GIT_SHA=local
LOG_LEVEL=INFO

# Firestore / Vertex AI
FIRESTORE_DATABASE=(default)
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=configure-current-supported-model

# Service URLs
KNOT_API_BASE_URL=http://localhost:8080
CREATOR_AGENT_BASE_URL=http://localhost:8081/a2a/v1
WEB3_GATEWAY_BASE_URL=http://localhost:8082

# Firebase client (not admin secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-me

# Solana devnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
KNOT_ESCROW_PROGRAM_ID=replace-me
KNOT_USDC_MINT=replace-me
BRAND_SIGNER_SECRET_NAME=knot-devnet-brand-signer

# pay.sh
PAYSH_MODE=sandbox
PAYSH_RESOURCE_ID=replace-me
PAYSH_SECRET_NAME=knot-paysh-token

# Safety
MAX_NEGOTIATION_ROUNDS=5
CONTENT_REVISION_LIMIT=1
